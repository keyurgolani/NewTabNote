{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "chrome"]
  },
  "include": ["js/kernel/**/*.js", "js/kernel/**/*.mjs", "test/kernel/**/*.mjs"]
}
