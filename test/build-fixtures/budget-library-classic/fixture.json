{
  "rule": "newtab.html loads Fuse.js as a classic script at start, the way 1.4.0 did (#27 AC3)",
  "expect": [
    "budget/forbidden"
  ],
  "modes": [
    "production"
  ],
  "edits": [
    {
      "file": "newtab.html",
      "replace": "<script vite-ignore src=\"js/entries/boot-guard.js\"></script>",
      "with": "<script vite-ignore src=\"js/lib/fuse.js\"></script>\n  <script vite-ignore src=\"js/entries/boot-guard.js\"></script>"
    },
    {
      "file": "build/budgets.json",
      "replace": "\"js\": { \"raw\": 716800, \"gzip\": 204800 }",
      "with": "\"js\": { \"raw\": 2097152, \"gzip\": 1048576 }"
    }
  ]
}
