{
  "rule": "chrome.runtime.getURL gets a path built at run time",
  "expect": [
    "closure/non-literal"
  ],
  "securityEntry": true,
  "edits": [
    {
      "file": "js/background.js",
      "replace": "documentUrls: [chrome.runtime.getURL('offscreen.html')]",
      "with": "documentUrls: [chrome.runtime.getURL(['offscreen', 'html'].join('.'))]"
    }
  ]
}
