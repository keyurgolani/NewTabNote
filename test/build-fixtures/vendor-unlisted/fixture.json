{
  "rule": "a vendored file ships with no js/lib/vendor.json record",
  "expect": [
    "vendor/unlisted"
  ],
  "edits": [
    {
      "file": "js/lib/ntn-fixture.js",
      "write": "window.ntnFixtureVendored = 1;\n"
    },
    {
      "file": "scripts/build/vite-config.js",
      "replace": "  'js/lib/fuse.js': 'as-is',\n",
      "with": "  'js/lib/ntn-fixture.js': 'as-is',\n  'js/lib/fuse.js': 'as-is',\n"
    },
    {
      "file": "newtab.html",
      "replace": "  <script vite-ignore src=\"js/entries/boot-guard.js\"></script>",
      "with": "  <script vite-ignore src=\"js/lib/ntn-fixture.js\"></script>\n  <script vite-ignore src=\"js/entries/boot-guard.js\"></script>"
    }
  ]
}
