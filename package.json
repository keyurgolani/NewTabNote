{
  "name": "new-tab-note",
  "version": "1.4.1",
  "description": "A rich block-based note editor Chrome extension that replaces your new tab page with AI-powered features",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "build:dev": "node scripts/build.js --dev",
    "clean": "rm -rf dist",
    "test": "node --experimental-vm-modules --test test/*.test.js test/kernel/*.test.mjs",
    "test:kernel": "node --test test/kernel/*.test.mjs",
    "test:extension": "playwright test -c e2e/playwright.config.js",
    "test:mutants": "node scripts/mutants.js",
    "typecheck": "tsc --project jsconfig.json",
    "typecheck:ratchet": "node scripts/build/type-gate.js",
    "typecheck:kernel": "tsc -p tsconfig.kernel.json",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "check:boundaries": "node scripts/check-boundaries.js",
    "check:dist": "node scripts/check-dist.js",
    "perf:probe": "node scripts/perf-probe.js",
    "format": "prettier --write .",
    "package": "node scripts/package.js",
    "release": "npm run clean && npm run build && npm run package && npm run check:notices",
    "check:notices": "node scripts/check-notices.js",
    "verify:fixtures": "node scripts/build/verify-fixtures.js",
    "verify:reproducible": "node scripts/build/verify-reproducible.js",
    "check:write-paths": "node scripts/write-paths.js",
    "check:destinations": "node scripts/check-destinations.js",
    "design-tokens": "node scripts/build-design-tokens.js",
    "design-token-scan": "node scripts/design-token-scan.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.10",
    "terser": "5.46.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "npm@11.16.0",
  "author": "Keyur Golani <keyurrgolani@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/keyurgolani/new-tab-note.git"
  }
}
