    "--type-title-weight": { "type": "font-weight", "axis": "typography", "status": "approved", "overridable": false, "values": { "default": "700" } },
    "--type-title-line-height": { "type": "line-height", "axis": "typography", "status": "approved", "overridable": false, "values": { "default": "1.2" } },
    "--type-body-size": { "type": "font-size", "axis": "typography", "status": "approved", "overridable": false, "role": "Body: writing, explanations, decision support", "values": { "default": "1rem" } },
    "--type-body-weight": { "type": "font-weight", "axis": "typography", "status": "approved", "overridable": false, "values": { "default": "400" } },
    "--type-body-line-height": { "type": "line-height", "axis": "typography", "status": "approved", "overridable": false, "values": { "default": "1.6" } },
    "--type-label-size": { "type": "font-size", "axis": "typography", "status": "approved", "overridable": false, "role": "Label: controls, states, provenance, compact metadata. The floor for functional text.", "values": { "default": "0.8rem" } },
