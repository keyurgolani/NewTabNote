      "values": { "light": "#526F69", "dark": { "value": "#E0E0E0", "legacy": "--text-primary" }, "forced": "CanvasText" }
    },
    "--ink-info": {
      "type": "color", "axis": "color", "status": "candidate", "overridable": false,
