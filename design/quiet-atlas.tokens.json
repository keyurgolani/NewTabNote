{
  "name": "Quiet Atlas",
  "version": 1,
  "about": [
    "The one source for NewTabNote's design tokens (#16). `npm run design-tokens` writes css/design-tokens.css and js/design/tokens.generated.js from it, and js/design/contrast.js validates every variant against the pair matrix below.",
    "Each token belongs to exactly one axis, and a variant only changes the tokens of its own axis.",
    "status: `approved` values come from the owner-approved table, DESIGN.md, or a rule the issue settles. `candidate` values ship until the owner answers (owner inputs 1 to 3 on #16).",
    "Plane naming (owner input 4): the shipped planes stand, --surface-collection sage-tinted and --surface-intelligence mist-tinted, as in the selected Quiet Atlas sketch and the review board."
  ],
  "pending": [
    {
      "input": 2,
      "cells": ["dark", "darkMore"],
      "types": ["color"],
      "about": "Quiet Atlas dark values. Until the owner supplies them, each dark color takes the legacy dark value for its role and anchors stay fills, so every dark color value is a candidate."
    }
  ],
  "axes": {
    "color": { "label": "Color", "dimensions": ["scheme", "contrast", "forcedColors"] },
    "typography": { "label": "Typography", "dimensions": ["readingFont"] },
    "density": { "label": "Density", "dimensions": ["density"] },
    "shape": { "label": "Shape and elevation", "dimensions": [] },
    "motion": { "label": "Motion", "dimensions": ["motion"] },
    "layout": { "label": "Layout", "dimensions": ["canvasWidth"] }
  },
  "dimensions": {
    "scheme": {
      "attribute": "data-scheme",
      "values": ["light", "dark", "system"],
      "default": "light",
      "system": { "value": "system", "media": "(prefers-color-scheme: dark)", "matched": "dark", "unmatched": "light" },
      "about": "No attribute and no JS means light, whatever the OS. Only `system` follows prefers-color-scheme."
    },
    "contrast": {
      "attribute": "data-contrast",
      "values": ["system", "more"],
      "default": "system",
      "media": { "query": "(prefers-contrast: more)", "value": "more" },
      "about": "prefers-contrast: more applies whatever the attribute says, since no value opts out of it."
    },
    "forcedColors": {
      "values": ["none", "active"],
      "default": "none",
      "media": { "query": "(forced-colors: active)", "value": "active" },
      "about": "Forced colors replace every color token with a system color, marked !important so custom overrides can't win."
    },
    "motion": {
      "attribute": "data-motion",
      "values": ["system", "reduce"],
      "default": "system",
      "media": { "query": "(prefers-reduced-motion: reduce)", "value": "reduce" },
      "about": "An OS reduce-motion setting beats any in-app choice."
    },
    "density": {
      "attribute": "data-density",
      "values": ["comfortable", "compact"],
      "default": "comfortable"
    },
    "readingFont": {
      "attribute": "data-reading-font",
      "values": ["sans", "serif", "mono"],
      "default": "sans",
      "about": "Applies to the canvas and note content only, on today's system stacks for serif and mono."
    },
    "canvasWidth": {
      "attribute": "data-canvas-width",
      "values": ["narrow", "default", "wide", "full"],
      "default": "default",
      "advisory": {
        "wide": "Lines can run past the 72ch reading measure.",
        "full": "Lines can run past the 72ch reading measure. Owner input 3: canvas at 100% as today, or text capped at 72ch."
      }
    }
  },
  "rules": {
    "ratios": { "text": 4.5, "non-text": 3, "focus": 3 },
    "typography": {
      "unit": "rem",
      "floor": "--type-label-size",
      "about": "Font sizes are rem, or clamp() with rem bounds, and never below the label size, the floor for functional text."
    },
    "targets": { "token": "--target-min", "minimum": "44px" },
    "motion": {
      "reducedDuration": "1ms",
      "about": "Reduced motion keeps opacity and color feedback at 1ms durations, so transitionend still fires, and drops translation and scaling."
    },
    "focus": {
      "width": "--focus-width",
      "offset": "--focus-offset",
      "minimumWidth": { "no-preference": "2px", "more": "3px" },
      "minimumOffset": "2px",
      "about": "A --focus-width outline in --focus-ring, offset --focus-offset, with an inner ring of --focus-ring-inner filling the offset. Focus Blue is under 3:1 on slate, sage, and every dark surface, so there the inner ring carries the contrast. A focus pair passes when the outer ring reaches 3:1 on the surface, or the inner ring reaches 3:1 against both the outer ring and the surface."
    },
    "forcedColors": {
      "focus": { "token": "--focus-ring", "value": "Highlight", "surfaces": ["Canvas"] },
      "boundaries": ["--seam", "--seam-strong", "--control-boundary"],
      "border": "1px solid transparent",
      "pairs": {
        "Canvas": ["CanvasText", "LinkText", "VisitedText", "ActiveText", "GrayText", "ButtonBorder"],
        "ButtonFace": ["ButtonText"],
        "Field": ["FieldText"],
        "Mark": ["MarkText"],
        "Highlight": ["HighlightText"],
        "SelectedItem": ["SelectedItemText"],
        "AccentColor": ["AccentColorText"]
      },
      "about": "Every pair is one of the legible system pairs in CSS Color 4 section 6.2, its foreground listed for its background, so a component that keeps its colors with forced-color-adjust: none stays readable. Focus is Highlight, drawn against Canvas: on a Canvas surface, or on the Canvas inner ring over any other. The focus ring isn't registered with @property, because a registered <color> computes Highlight to a fixed color and forced colors then repaint the outline. Planes, cards, inputs, and selected states get a 1px solid transparent border or outline, which forced colors paint. The static check covers token values; whether components draw that border needs rendered DOM (#24)."
    },
    "disabled": {
      "state": "disabled",
      "opacity": "--disabled-opacity",
      "about": "Disabled pairs are composited at --disabled-opacity over their backdrop and reported as advisories. WCAG 2.x SC 1.4.3 and 1.4.11 set no contrast requirement for inactive components."
    }
  },
  "tokens": {
    "--surface-app": {
      "type": "color", "axis": "color", "status": "approved", "overridable": true,
      "role": "Mineral Ground: the application field",
      "values": { "light": "#F4F6F3", "dark": { "value": "#252525", "legacy": "--bg-secondary" }, "forced": "Canvas" }
    },
    "--surface-navigation": {
      "type": "color", "axis": "color", "status": "approved", "overridable": false,
      "role": "Deep Slate: navigation and structural anchors",
      "values": { "light": "#253443", "dark": { "value": "#253443", "note": "Anchors stay fills." }, "forced": "Canvas" }
    },
    "--surface-paper": {
      "type": "color", "axis": "color", "status": "approved", "overridable": true,
      "role": "Paper Canvas: active note and task surfaces, the brightest and quietest plane",
      "values": { "light": "#FFFFFF", "dark": { "value": "#191919", "legacy": "--bg-primary" }, "forced": "Canvas" }
    },
    "--surface-collection": {
      "type": "color", "axis": "color", "status": "approved", "overridable": false,
      "role": "Collection plane, sage-tinted",
      "values": { "light": "#E7EDEB", "dark": { "value": "#252525", "legacy": "--bg-secondary" }, "forced": "Canvas" }
    },
    "--surface-intelligence": {
      "type": "color", "axis": "color", "status": "approved", "overridable": false,
      "role": "Intelligence plane, mist-tinted",
      "values": { "light": "#E9EDF3", "dark": { "value": "#252525", "legacy": "--bg-secondary" }, "forced": "Canvas" }
    },
    "--surface-muted": {
      "type": "color", "axis": "color", "status": "approved", "overridable": true,
      "role": "Quiet fills, such as a quiet button's hover",
      "values": { "light": "#E8ECEA", "dark": { "value": "#2F2F2F", "legacy": "--bg-hover" }, "forced": "Canvas" }
    },
    "--surface-code": {
      "type": "color", "axis": "color", "status": "candidate", "overridable": true,
      "role": "Code blocks and inline code",
      "values": { "light": "#F4F6F3", "dark": { "value": "#2A2A2A", "legacy": "--code-bg" }, "forced": "Canvas" }
    },
    "--text-primary": {
      "type": "color", "axis": "color", "status": "approved", "overridable": true,
      "role": "Deep Slate: primary text",
      "values": { "light": "#253443", "dark": { "value": "#E0E0E0", "legacy": "--text-primary" }, "forced": "CanvasText" }
    },
    "--text-secondary": {
      "type": "color", "axis": "color", "status": "approved", "overridable": true,
      "role": "Secondary text",
      "values": {
        "light": "#52616A",
        "dark": { "value": "#9B9B9B", "legacy": "--text-secondary" },
        "more": { "ref": "--text-primary", "note": "Contrast-more swaps secondary text for primary text." },
