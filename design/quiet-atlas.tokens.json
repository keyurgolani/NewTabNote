      "role": "Text on slate",
      "values": { "light": "#F7F9F8", "dark": { "value": "#E0E0E0", "legacy": "--text-primary" }, "forced": "CanvasText" }
    },
    "--text-on-sage": {
      "type": "color", "axis": "color", "status": "approved", "overridable": false,
      "role": "Paper text on sage fills, such as the active nav field",
      "values": { "light": "#FFFFFF", "dark": { "value": "#FFFFFF", "legacy": "white text on accent and danger fills" }, "forced": "SelectedItemText" }
    },
    "--text-on-action": {
      "type": "color", "axis": "color", "status": "approved", "overridable": false,
      "role": "Paper text on action fills: the primary and destructive buttons, as DESIGN.md gives the primary button paper text",
      "values": { "light": "#FFFFFF", "dark": { "value": "#FFFFFF", "legacy": "white text on accent and danger fills" }, "forced": "ButtonText" }
    },
    "--text-link": {
      "type": "color", "axis": "color", "status": "candidate", "overridable": false,
      "role": "Links, underlined",
      "values": { "light": { "ref": "--text-primary" }, "dark": { "ref": "--text-primary" }, "forced": "LinkText" }
    },
    "--action-primary": {
      "type": "color", "axis": "color", "status": "approved", "overridable": true,
      "role": "Deep Slate: the one primary action",
      "values": { "light": "#253443", "dark": { "value": "#253443", "note": "Anchors stay fills." }, "forced": "ButtonFace" }
    },
    "--action-destructive": {
      "type": "color", "axis": "color", "status": "approved", "overridable": true,
      "role": "Destructive fills: the danger color as a fill under --text-on-action",
      "values": { "light": { "ref": "--state-danger" }, "dark": { "ref": "--state-danger" }, "forced": "ButtonFace" }
    },
    "--state-local": {
      "type": "color", "axis": "color", "status": "approved", "overridable": false,
      "role": "Private Sage: local or private state, success, trusted actions, intelligence ownership, the active nav field. Forced colors paint the field as a selected item.",
      "values": { "light": "#526F69", "dark": { "value": "#526F69", "note": "Anchors stay fills." }, "forced": "SelectedItem" }
    },
    "--state-info": {
      "type": "color", "axis": "color", "status": "approved", "overridable": false,
      "role": "Collection Mist: linked context, collection surfaces, secondary information, non-urgent intelligence. Never a fill under text.",
      "values": { "light": "#7184A3", "dark": { "value": "#7184A3", "note": "Anchors stay fills." }, "forced": "CanvasText" }
    },
    "--state-urgent": {
      "type": "color", "axis": "color", "status": "approved", "overridable": false,
      "role": "Urgency Clay: explicit deadlines, attention, recoverable warnings. Never text, and never a fill under text.",
      "values": { "light": "#B78E76", "dark": { "value": "#B78E76", "note": "Anchors stay fills." }, "forced": "CanvasText" }
    },
    "--state-pending": {
      "type": "color", "axis": "color", "status": "approved", "overridable": false,
      "role": "Supporting Sand: pending, supporting, resurfaced",
      "values": { "light": "#DED7BA", "dark": { "value": "#DED7BA", "note": "Anchors stay fills." }, "forced": "CanvasText" }
    },
    "--state-danger": {
