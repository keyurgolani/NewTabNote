    "--focus-ring": {
      "type": "color", "axis": "color", "status": "approved", "overridable": false,
      "registered": false,
      "about": "Not registered with @property: a registered <color> computes Highlight to a fixed color, and forced colors then repaint the outline in their own default. Unregistered, outline-color gets the Highlight keyword. It isn't overridable, so it doesn't need the fallback registration gives an invalid value.",
      "role": "Focus Blue: focus only",
      "values": { "light": "#315F8A", "dark": { "value": "#315F8A", "note": "2.62:1 on #191919, so dark focus relies on the inner ring." }, "forced": "Highlight" }
    },
    "--focus-ring-inner": {
      "type": "color", "axis": "color", "status": "approved", "overridable": false,
      "role": "The focus ring's inner ring: paper in light, --text-on-dark in dark",
