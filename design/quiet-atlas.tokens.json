      "values": { "light": "#68624B", "dark": { "value": "#E0E0E0", "legacy": "--text-primary" }, "forced": "CanvasText" }
    },
    "--tint-local": {
      "type": "color", "axis": "color", "status": "candidate", "overridable": false,
