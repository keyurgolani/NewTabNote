# Dependencies
node_modules/

# Build output
dist/
releases/
# What scripts/build.js writes before its checks pass and it renames it to dist/
/.dist-staging-*/
# Build reports, such as #27's chunk graph, source maps and perf:probe's JSON, which never ship
dist-report/
# Release files frozen as #17's test fixtures, not build output
!/test/fixtures/storage/releases/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
# The Impeccable design hook's per-session cache, which it writes in every worktree
.impeccable/

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# Playwright output (npm run test:extension)
test-results/
